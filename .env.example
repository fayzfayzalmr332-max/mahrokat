# ⚠️ هذا ملف نموذج ONLY — ضع القيم الحقيقية في إعدادات الاستضافة (Render/Fly Dashboard)
# ولا تضع الأسرار أبداً داخل الكود أو داخل ملف .env مرفوع في الريبو.

# ── Telegram ─────────────────────────────────────────────
# التوكن من @BotFather
TELEGRAM_BOT_TOKEN=

# ── Supabase ─────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── المالك الوحيد ────────────────────────────────────────
# Telegram User ID (رقم صحيح فقط) — عرّفه من @userinfobot
OWNER_TELEGRAM_ID=

# ── المحاسب (اختياري) ────────────────────────────────────
# معرّف تليجرام إضافي يملك صلاحيات المالك نفسها في البوت.
# إن تُرك فارغاً، يبقى الوصول للمالك فقط.
ACCOUNTANT_TELEGRAM_ID=

# ── اختياري: وضع Webhook بدلاً من Polling ────────────────
# مثال: https://yoursubdomain.onrender.com/<TOKEN>
WEBHOOK_URL=
WEBHOOK_SECRET_TOKEN=
PORT=8080

# ── تسجيل الأحداث ────────────────────────────────────────
LOG_LEVEL=INFO